{
  "extends": ["taro/react", "prettier"],
  "rules": {
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["**/*.config.js"],
      "parser": "espree",
      "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
      "env": { "node": true },
      "rules": { "import/no-commonjs": "off" }
    }
  ]
}
