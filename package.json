{
  "name": "taro-ui-kit",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:example": "pnpm --filter example dev:weapp",
    "dev:h5": "pnpm --filter example dev:h5",
    "dev:docs": "pnpm --filter lb-ui-docs dev",
    "build": "pnpm --filter @lb/taro-ui build",
    "build:h5": "pnpm --filter example build:h5",
    "build:docs": "pnpm --filter lb-ui-docs build",
    "sync:h5": "rm -rf packages/docs/public/h5 && cp -R packages/example/dist packages/docs/public/h5",
    "build:site": "pnpm build:h5 && pnpm sync:h5 && pnpm build:docs",
    "test": "pnpm --filter @lb/taro-ui test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0"
  }
}